# ========================================
# CC -Vision Core Config Import Components
# Git Exclusions
# ========================================

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.virtualenv/
.pytest_cache/

# Credentials and secrets
.env
.env.*
*.ini
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# Operational configuration exports
*.json
# Only synthetic examples and test fixtures belong in version control.
!/examples/offline-controller/*.json
!/tests/fixtures/**/*.json
cyber_controller_*.json
exports/
backups/
runtime/
data/
config/

# Vendor references and Docker image archives stay outside Git.
*.pdf
*.PDF
*.tar
*.tar.gz
*.tgz

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.swp

# Windows
Thumbs.db
Desktop.ini

# Original migration scripts
# Excluded until security review
/legacy/